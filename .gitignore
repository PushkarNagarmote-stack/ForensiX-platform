# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Forensic generated data & disk images (keeps directories with .gitkeep)
data/disks/*.img
data/disks/*.raw
data/disks/*.dd
data/disks/*.bin
!data/disks/.gitkeep
data/recovered/*
!data/recovered/.gitkeep
data/certificates/*.pdf
!data/certificates/.gitkeep

# IDEs & System files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
